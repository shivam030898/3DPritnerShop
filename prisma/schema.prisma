generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  designs       Design[]
  savedProducts SavedProduct[]
  addresses     Address[]
  notifications Notification[]
  cartItems     CartItem[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
}

model Design {
  id            String    @id @default(cuid())
  userId        String
  name          String
  fileUrl       String
  fileType      String
  previewUrl    String?
  volumeCm3     Float
  dimensionsCm  String
  material      String?
  color         String?
  quality       String?
  lastPrice     Int?
  createdAt     DateTime  @default(now())
  lastOrderedAt DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]
}

model CartItem {
  id          String   @id @default(cuid())
  userId      String
  configKey   String
  type        String // "product" | "custom"
  slug        String? // marketplace product slug
  imageId     String? // marketplace product preview image
  name        String
  fileName    String?
  fileUrl     String?
  fileType    String?
  statsJson   String? // serialized GeometryStats for custom prints
  material    String?
  color       String?
  quality     String?
  sizeLabel   String? // "Small" | "Medium" | "Large"
  widthMm     Float?
  depthMm     Float?
  heightMm    Float?
  quantity    Int
  unitPrice   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, configKey])
}

model SavedProduct {
  id          String   @id @default(cuid())
  userId      String
  productSlug String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productSlug])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  label     String
  name      String
  line1     String
  city      String
  state     String
  pin       String
  isDefault Boolean @default(false)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]
}

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  userId          String
  designId        String?
  productSlug     String?
  itemName        String
  itemType        String
  material        String?
  color           String?
  quality         String?
  sizeLabel       String?
  widthMm         Float?
  depthMm         Float?
  heightMm        Float?
  quantity        Int
  unitPrice       Int
  subtotal        Int
  shipping        Int
  total           Int
  paymentMethod   String
  paymentStatus   String   @default("paid")
  addressId       String?
  addressSnapshot String
  trackingNumber  String
  carrier         String
  createdAt       DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  design        Design?       @relation(fields: [designId], references: [id])
  address       Address?      @relation(fields: [addressId], references: [id])
  statusHistory StatusEvent[]
}

model StatusEvent {
  id        String   @id @default(cuid())
  orderId   String
  stage     String
  timestamp DateTime

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
